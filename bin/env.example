

export MAAS_BASE_URL=https://xxxxxx/api/gateway
export MAAS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


BUILDKIT_DIR="$HOME/workdir/buildkit"
if [ ! -d $BUILDKIT_DIR ] && [ -d $HOME/github/workdir/buildkit ]; then
    BUILDKIT_DIR="$HOME/github/workdir/buildkit"
fi
if [ ! -d $BUILDKIT_DIR ] && [ -d /home/github/workdir/buildkit ]; then
    BUILDKIT_DIR="/home/github/workdir/buildkit"
fi

if [ -d $BUILDKIT_DIR ]; then
    [ ! -d ~/.grok ] && mkdir -p ~/.grok
    [ ! -e ~/.grok/config.toml ] && ln -s $BUILDKIT_DIR/bin/grok-config.toml ~/.grok/config.toml

    [ ! -d ~/.cargo ] && mkdir -p ~/.cargo
    [ ! -e ~/.cargo/config.toml ] && ln -s $BUILDKIT_DIR/bin/cargo-config.toml ~/.cargo/config.toml

    [ ! -d ~/.claude ] && mkdir -p ~/.claude
    [ ! -e ~/.claude/settings.json ] && ln -s $BUILDKIT_DIR/bin/claude-settings.json ~/.claude/settings.json
fi

export PATH=$PATH:$BUILDKIT_DIR/bin

export RUSTUP_DIST_SERVER="https://rsproxy.cn"
export RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"

if command -v bat &> /dev/null; then
    alias cat='bat -pp'
fi
alias git-log='git log --pretty=format:"%h - %an %ae, %ar : %s"'
if command -v atuin &> /dev/null; then
    eval "$(atuin init bash --disable-up-arrow)"
fi

export GROK_MODELS_BASE_URL=${MAAS_BASE_URL}/v1

export ANTHROPIC_BASE_URL=${MAAS_BASE_URL}/anthropic
export ANTHROPIC_AUTH_TOKEN=$MAAS_API_KEY
