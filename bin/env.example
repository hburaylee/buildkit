
[ ! -d ~/.grok ] && mkdir -p ~/.grok
[ ! -e ~/.grok/config.toml ] && ln -s ~/workdir/buildkit/bin/grok-config.toml ~/.grok/config.toml

[ ! -d ~/.cargo ] && mkdir -p ~/.cargo
[ ! -e ~/.cargo/config.toml ] && ln -s ~/workdir/buildkit/bin/cargo-config.toml ~/.cargo/config.toml

[ ! -d ~/.claude ] && mkdir -p ~/.claude
[ ! -e ~/.claude/settings.json ] && ln -s ~/workdir/buildkit/bin/claude-settings.json ~/.claude/settings.json

export MAAS_BASE_URL=https://xxxxxx/api/gateway
export MAAS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

export PATH=$PATH:~/workdir/buildkit/bin

export RUSTUP_DIST_SERVER="https://rsproxy.cn"
export RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"

alias git-log='git log --pretty=format:"%h - %an %ae, %ar : %s"'
eval "$(atuin init bash --disable-up-arrow)"

export GROK_MODELS_BASE_URL=${MAAS_BASE_URL}/v1

export ANTHROPIC_BASE_URL=${MAAS_BASE_URL}/anthropic
export ANTHROPIC_AUTH_TOKEN=$MAAS_API_KEY
